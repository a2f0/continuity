{
  "schemaVersion": 1,
  "subject": {
    "maxLength": 50,
    "types": [
      "build",
      "chore",
      "ci",
      "cleanup",
      "docs",
      "feat",
      "fix",
      "perf",
      "refactor",
      "revert",
      "style",
      "test"
    ]
  },
  "merge": {
    "requiredChecks": [
      {
        "name": "CI gate",
        "workflow": "CI"
      }
    ]
  },
  "versions": {
    "packages": ["."]
  },
  "pr": {
    "rejectClaudeBranding": true
  },
  "branch": {
    "types": [
      "build",
      "chore",
      "ci",
      "cleanup",
      "docs",
      "feat",
      "fix",
      "perf",
      "refactor",
      "revert",
      "style",
      "test"
    ],
    "exempt": ["main"],
    "maxLength": 50
  },
  "hooks": {
    "files": [
      {
        "source": "scripts/git/hooks/commit-msg",
        "target": "commit-msg",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-commit",
        "target": "pre-commit",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-push",
        "target": "pre-push",
        "executable": true
      }
    ]
  },
  "pushGate": {
    "steps": [
      {
        "label": "format-and-lint",
        "command": ["bun", "run", "lint:biome"]
      },
      {
        "label": "file-names",
        "command": ["bun", "run", "lint:files"]
      },
      {
        "label": "markdown",
        "command": ["bun", "run", "lint:markdown"]
      },
      {
        "label": "shell",
        "command": ["bun", "run", "lint:scripts"]
      },
      {
        "label": "project-skills",
        "command": ["bun", "run", "lint:skills"]
      },
      {
        "label": "binary-policy",
        "command": ["bun", "run", "lint:binary-files"]
      },
      {
        "label": "unused-code",
        "command": ["bun", "run", "lint:knip"]
      },
      {
        "label": "types",
        "command": ["bun", "run", "typecheck"]
      }
    ],
    "budgetSeconds": 120
  },
  "binaries": {
    "allow": [
      "assets/fonts/**/*.ttf",
      "assets/portraits/**/*.{jpg,png}",
      "assets/household/**/*.jpg",
      "genesis/**/*.{jpg,png}"
    ]
  },
  "commits": {
    "signatures": "none",
    "signatureHeaderFallback": false,
    "rejectCoauthors": true,
    "subjects": false
  },
  "permissions": {
    "executables": {
      "commitlint": "local",
      "playwright": "local",
      "wrangler": "release"
    }
  },
  "images": {
    "targets": {
      "favicons": {
        "outputs": [
          {
            "path": "favicon.svg",
            "layers": [{ "source": "logo" }]
          },
          {
            "path": "favicon.ico",
            "sizes": [16, 32, 48],
            "layers": [{ "source": "logo" }]
          },
          {
            "path": "apple-touch-icon.png",
            "size": 180,
            "opaque": true,
            "layers": [
              { "fill": "#222522" },
              { "source": "logo", "scale": 0.8 }
            ]
          }
        ]
      }
    }
  }
}
