{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tearleads-continuity",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  // tearleads/terraform/stacks/prod/continuity owns continuity.tearleads.com.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
