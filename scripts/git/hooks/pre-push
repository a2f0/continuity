#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# A copied hook must match the checked-out version before it can gate a push.
if ! cmp -s "$0" "$REPO_ROOT/scripts/git/hooks/pre-push"; then
  echo "Error: pre-push hook is stale. Run bun run hooks:install." >&2
  exit 1
fi

cd "$REPO_ROOT"

# Check every non-deleted destination branch named in Git's push tuples.
bun run agent-tool branch check --pre-push

bun run check
