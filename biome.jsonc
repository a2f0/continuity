{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      // Generated by `bun run genesis` and verified byte-for-byte by
      // `bun run genesis:check`; formatting it here would fight the generator.
      "!!genesis"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "markdown": {
    // Markdownlint owns Markdown formatting, including project skill copies.
    // Managed skills are checked byte for byte by agents:check.
    "formatter": { "enabled": false }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 75,
            "skipBlankLines": true,
            "skipIifes": true
          }
        }
      },
      "suspicious": {
        // Shared shapes belong in a lower module (src/export/seedTypes.ts);
        // a cycle means a dependency points the wrong way. Type-only imports
        // count too: they tangle module ownership just the same.
        "noImportCycles": {
          "level": "error",
          "options": { "ignoreTypes": false }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    // Module boundaries from AGENTS.md "Code organization" and
    // docs/development.md "Module layering". Tests may load the concrete world.
    {
      "includes": ["src/canon/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/render/**",
                      "**/export/**",
                      "**/genesis/**",
                      "**/site/**",
                      "**/portraits/**",
                      "**/canon/world"
                    ],
                    "message": "src/canon/ stays independent of rendering, exports, and the concrete world; pass World in."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/render/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/genesis/**",
                      "**/export/**",
                      "**/site/**",
                      "**/canon/world"
                    ],
                    "message": "Renderers take explicit inputs; genesis coordinates them, not the reverse."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/site/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/canon/world"],
                    "message": "src/site/ reads facts from the genesis/ snapshot, not canon/world.ts."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
